<%= form_with(model: account, class: "contents") do |form| %>
  <%= hidden_field_tag :tab, "payments" %>
  <% if account.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>

      <ul class="list-disc ml-6">
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="<%= table_container_class("p-6") %>">
    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">GoCardless Configuration</h2>
        <p class="<%= help_text_class %>">Enter your GoCardless access token to enable integrated payments for your customers.</p>
      </div>

      <div>
        <%= form.label :gocardless_access_token, "Access Token", class: label_class %>
        <%= form.password_field :gocardless_access_token, value: account.gocardless_access_token, placeholder: "e.g. live_...", class: input_class(account.errors[:gocardless_access_token].any?) %>
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">You can find your access token in the GoCardless dashboard under Developers > Access Tokens.</p>
      </div>

      <fieldset>
        <legend class="<%= label_class %>">Mode</legend>
        <div class="mt-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="relative flex cursor-pointer rounded-lg border border-gray-300 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <%= form.radio_button :gocardless_mode, "sandbox", class: "peer sr-only", "aria-labelledby": "gocardless-mode-0-label" %>
            <span class="flex flex-1">
              <span class="flex flex-col">
                <span id="gocardless-mode-0-label" class="block text-sm font-medium text-gray-900 dark:text-white">Sandbox</span>
                <span class="mt-1 text-sm text-gray-500 dark:text-gray-400">For testing and development</span>
              </span>
            </span>
            <svg class="invisible h-5 w-5 text-indigo-600 peer-checked:visible" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="pointer-events-none absolute -inset-px rounded-lg border-2 border-transparent peer-checked:border-indigo-600" aria-hidden="true"></span>
          </label>

          <label class="relative flex cursor-pointer rounded-lg border border-gray-300 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <%= form.radio_button :gocardless_mode, "production", class: "peer sr-only", "aria-labelledby": "gocardless-mode-1-label" %>
            <span class="flex flex-1">
              <span class="flex flex-col">
                <span id="gocardless-mode-1-label" class="block text-sm font-medium text-gray-900 dark:text-white">Production</span>
                <span class="mt-1 text-sm text-gray-500 dark:text-gray-400">For real transactions</span>
              </span>
            </span>
            <svg class="invisible h-5 w-5 text-indigo-600 peer-checked:visible" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="pointer-events-none absolute -inset-px rounded-lg border-2 border-transparent peer-checked:border-indigo-600" aria-hidden="true"></span>
          </label>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="mt-6">
    <%= form.submit "Save Payment Settings", class: primary_button_class("w-full sm:w-auto") %>
  </div>
<% end %>
