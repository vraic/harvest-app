<% content_for :title, "Showing customer" %>

<% showing_archived = params[:view] == "archived" || @customer.deleted? %>
<% back_path = showing_archived ? customers_path(view: "archived") : customers_path %>

<div class="md:w-2/3 w-full">

  <h1 class="font-bold text-4xl">Showing customer</h1>

  <%= render @customer %>

  <div class="flex flex-wrap gap-2 mt-4">
    <% unless @customer.deleted? %>
      <%= link_to "Edit this customer", edit_customer_path(@customer), class: secondary_button_class("w-full sm:w-auto text-center") %>
      <%= button_to "Archive this customer", customer_path(@customer), method: :delete, form_class: "w-full sm:w-auto", class: danger_button_class("w-full"), data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
    <%= link_to "Back to customers", back_path, class: secondary_button_class("w-full sm:w-auto text-center") %>
    <%= button_to "Anonymise this customer", anonymise_customer_path(@customer, view: (showing_archived ? "archived" : nil)), method: :patch, form_class: "w-full sm:w-auto", class: danger_button_class("w-full bg-amber-700 hover:bg-amber-600"), data: { turbo_confirm: "Are you sure? This will irreversibly anonymise personal data." } %>
    <% if policy(@customer).really_destroy? %>
      <%= button_to "Really Delete", really_destroy_customer_path(@customer, view: (showing_archived ? "archived" : nil)), method: :delete, form_class: "w-full sm:w-auto", class: danger_button_class("w-full bg-red-800 hover:bg-red-700"), data: { turbo_confirm: "Are you sure? This is permanent." } %>
    <% end %>
  </div>
</div>
