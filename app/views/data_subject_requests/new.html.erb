<% content_for :title, "New Data Rights Request" %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">New Data Rights Request</h1>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Log a request for access, rectification, erasure, restriction, objection, or portability.</p>

  <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-gray-900">
    <%= render "form", data_subject_request: @data_subject_request, submit_label: "Create request" %>
  </div>
</div>