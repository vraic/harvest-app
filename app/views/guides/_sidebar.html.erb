<aside class="w-full">
  <p class="mb-4 px-0.5 text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Guides</p>
  <nav aria-label="Guides navigation">
    <ul class="space-y-6">
      <% guides_sidebar_sections(sections).each do |section| %>
        <li>
          <p class="px-0.5 pb-2 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500"><%= section.title %></p>
          <ul class="space-y-1.5">
            <% section.documents.each do |doc| %>
              <% active = current_doc&.slug == doc.slug %>
              <li>
                <%= link_to guide_page_path_with_query(doc.slug, query),
                            class: [
                              "group block border-l-2 py-1.5 pl-3 pr-1 text-sm leading-6 transition-colors",
                              active ? "border-red-700 font-semibold text-slate-900" : "border-transparent text-slate-700 hover:border-slate-300 hover:text-slate-900"
                            ].join(" ") do %>
                  <span class="block"><%= doc.title %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </nav>
</aside>
