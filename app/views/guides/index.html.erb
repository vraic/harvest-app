<% content_for :title, "Guides" %>
<% content_for :no_sidebar, true %>

<div class="-mx-4 -my-10 min-h-screen bg-[#f7f7f7] text-slate-900 sm:-mx-6 lg:-mx-8">
  <header class="sticky top-0 z-40 border-b border-slate-300 bg-white">
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-3 px-4 py-3 sm:px-6 lg:px-8">
      <%= link_to guides_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-900" do %>
        <span class="inline-flex size-7 items-center justify-center rounded-full border border-red-700 bg-red-700 text-xs font-bold text-white">H</span>
        <span>Harvest Guides</span>
      <% end %>

      <span class="hidden text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 md:inline-flex">Reference</span>

      <%= form_with url: guides_path, method: :get, local: true, class: "ml-auto flex w-full items-center gap-2 sm:w-auto" do |form| %>
        <label for="docs-query" class="sr-only">Search guides</label>
        <%= form.search_field :q, value: @query, id: "docs-query", placeholder: "Search guides", class: "w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-red-600 focus:outline-none sm:w-72" %>
        <%= form.submit "Search", class: "inline-flex shrink-0 items-center rounded border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" %>
      <% end %>

      <%= link_to "GitHub", "https://github.com/vraic/harvest-je", target: "_blank", rel: "noopener noreferrer", class: "hidden text-sm font-medium text-slate-600 transition hover:text-slate-900 lg:inline-flex" %>
      <%= link_to "Home", root_path, class: "hidden text-sm font-medium text-slate-600 transition hover:text-slate-900 lg:inline-flex" %>
    </div>
  </header>

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[21rem_minmax(0,1fr)] xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto py-8 pr-8">
          <div class="border-l border-slate-200/90 pl-5">
            <%= render "sidebar", sections: @guide_sections, current_doc: nil, query: @query %>
          </div>
        </div>
      </aside>

      <main class="min-w-0 py-8">
        <div class="mb-8 border-b border-slate-300 pb-6">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Harvest Guides</p>
          <h1 class="mt-2 text-4xl font-semibold tracking-tight text-slate-900" style="font-family: Georgia, Cambria, 'Times New Roman', Times, serif;">Guides</h1>
          <p class="mt-3 max-w-3xl text-base text-slate-700">
            Practical, step-by-step guides for running and operating Harvest.
          </p>
        </div>

        <aside class="mb-8 rounded-xl border border-slate-200 bg-slate-50/70 p-4 lg:hidden">
          <%= render "sidebar", sections: @guide_sections, current_doc: nil, query: @query %>
        </aside>

        <% if @query.present? %>
          <section class="mb-10">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b border-slate-300 pb-3">
              <h2 class="text-xl font-semibold text-slate-900">Search results</h2>
              <p class="text-sm text-slate-500"><%= pluralize(@search_results.size, "result") %> for “<%= @query %>”</p>
            </div>

            <% if @search_results.any? %>
              <ul class="divide-y divide-slate-200 rounded border border-slate-300 bg-white">
                <% @search_results.each do |result| %>
                  <li>
                    <%= link_to guide_page_path_with_query(result.document.slug, @query), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
                      <p class="text-base font-semibold text-slate-900"><%= result.document.title %></p>
                      <% if result.document.description.present? %>
                        <p class="mt-1 text-sm text-slate-500"><%= result.document.description %></p>
                      <% end %>
                      <p class="mt-2 text-sm leading-6 text-slate-700"><%= guides_search_highlight(result.excerpt, @query) %></p>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <div class="rounded border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
                No matches found. Try different keywords.
              </div>
            <% end %>
          </section>
        <% end %>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900" style="font-family: Georgia, Cambria, 'Times New Roman', Times, serif;">Guides index</h2>
          <div class="mt-4 space-y-6">
            <% @guide_sections.each do |section| %>
              <section class="rounded border border-slate-300 bg-white">
                <div class="border-b border-slate-300 px-5 py-3">
                  <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-700"><%= section.title %></h3>
                </div>
                <ol class="divide-y divide-slate-200">
                  <% section.documents.each do |doc| %>
                    <li>
                      <%= link_to guide_page_path_with_query(doc.slug, @query), class: "block px-5 py-4 transition hover:bg-red-50/50" do %>
                        <p class="text-base font-medium text-slate-900"><%= doc.title %></p>
                        <% if doc.description.present? %>
                          <p class="mt-1 text-sm text-slate-600"><%= doc.description %></p>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ol>
              </section>
            <% end %>
          </div>
        </section>
      </main>
    </div>
  </div>
</div>
