<% flash.each do |type, message| %>
  <%
    colors = case type.to_sym
             when :notice, :success
               { border: "border-green-500", bg: "bg-green-100 dark:bg-green-900/30", text: "text-green-800 dark:text-green-200" }
             when :alert, :error
               { border: "border-red-500", bg: "bg-red-100 dark:bg-red-900/30", text: "text-red-800 dark:text-red-200" }
             else
               { border: "border-orange-500", bg: "bg-orange-100 dark:bg-orange-900/30", text: "text-orange-800 dark:text-orange-200" }
             end
  %>
  <div data-controller="flash"
       class="pointer-events-auto flex w-full max-w-sm items-center gap-3 rounded-md border-l-4 <%= colors[:border] %> <%= colors[:bg] %> px-4 py-3 shadow-lg"
       style="transition: opacity 300ms, transform 300ms; opacity: 1;">
    <p class="flex-1 text-sm font-medium <%= colors[:text] %>"><%= message %></p>
    <button type="button"
            data-action="click->flash#dismiss"
            class="inline-flex shrink-0 rounded-md <%= colors[:text] %> opacity-60 hover:opacity-100 focus:outline-2 focus:outline-offset-2 focus:outline-indigo-500">
      <span class="sr-only">Close</span>
      <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-4">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
      </svg>
    </button>
  </div>
<% end %>
