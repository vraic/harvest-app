<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "harvest.je" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Harvest">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "lexxy-content", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
  </head>

  <body class="bg-gray-50 dark:bg-gray-900 h-full">
    <div id="flash" aria-live="assertive" class="pointer-events-none fixed inset-0 flex items-start px-4 py-6 sm:p-6 z-[100]">
      <div id="flash-container" class="flex w-full flex-col items-end space-y-4">
        <%= render "layouts/flash" if flash.any? %>
      </div>
    </div>

    <% show_admin_support_banner = Current.user&.admin? && Current.account %>
    <% if show_admin_support_banner %>
      <div class="w-full bg-indigo-600 text-white shadow-sm">
        <div class="flex items-center justify-center gap-4 px-4 py-2 text-center text-sm font-medium sm:px-6 lg:px-8">
          <span class="uppercase tracking-wide text-xs font-semibold text-indigo-100">Admin Support Mode</span>
          <span>Acting on behalf of: <span class="font-bold"><%= Current.account.name %></span></span>
          <%= button_to "Leave Account", leave_account_path(Current.account), method: :post, class: "underline hover:text-indigo-100" %>
        </div>
      </div>
    <% end %>


    <el-dialog>
      <% unless content_for?(:no_sidebar) %>
        <dialog id="sidebar" class="backdrop:bg-transparent lg:hidden">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-900/80 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>

        <div tabindex="0" class="fixed inset-0 flex focus:outline-none">
          <el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
            <div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
              <button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
                <span class="sr-only">Close sidebar</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-white">
                  <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>

            <!-- Sidebar component, swap this element with another sidebar if you like -->
            <div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-white px-6 pb-2 dark:bg-gray-900 dark:ring dark:ring-white/10 dark:before:pointer-events-none dark:before:absolute dark:before:inset-0 dark:before:bg-black/10">
              <% sidebar_staff_navigation = staff_navigation? %>
              <% sidebar_unread_notifications_count = sidebar_staff_navigation ? unread_notifications_count : 0 %>
              <div class="relative flex h-16 shrink-0 items-center justify-between">
                <div class="flex items-center">
                  <%= image_tag "icon.svg", alt: "Harvest", class: "h-8 w-auto dark:hidden" %>
                  <%= image_tag "icon.svg", alt: "Harvest", class: "h-8 w-auto not-dark:hidden" %>
                </div>
                <% if sidebar_staff_navigation %>
                  <%= link_to notifications_path, id: "mobile-sidebar-notifications-link", class: nav_icon_button_classes(:notifications), aria: { label: "Notifications" } do %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="<%= nav_icon_classes(:notifications) %>">
                      <path d="M14.857 17.082a23.848 23.848 0 0 1 5.454 1.31A8.967 8.967 0 0 1 18 9.75v-.7V9A6 6 0 0 0 6 9v.05a8.967 8.967 0 0 1-2.312 9.343 23.848 23.848 0 0 1 5.454-1.31m5.715 0a24.255 24.255 0 0 0-5.714 0m5.714 0a3 3 0 1 1-5.714 0" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <% if sidebar_unread_notifications_count.positive? %>
                      <span id="mobile-notifications-badge" class="absolute -right-1 -top-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-600 px-1 text-[0.625rem] font-bold text-white"><%= sidebar_unread_notifications_count > 99 ? "99+" : sidebar_unread_notifications_count %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
              <%= render "layouts/navigation", mobile: true %>
              <% if authenticated? %>
                <ul role="list" class="-mx-2 space-y-1 mt-auto">
                  <% if show_account_switcher? %>
                    <li>
                      <button type="button" command="show-modal" commandfor="account-switcher" class="group flex w-full gap-x-3 rounded-md p-2 text-sm/6 font-semibold text-gray-700 hover:text-indigo-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-white/5">
                        <svg class="size-6 shrink-0 text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                        </svg>
                        Switch Account
                      </button>
                    </li>
                  <% end %>
                </ul>

                <%= render "layouts/sidebar_cart_link", sidebar: :mobile %>

                <div class="-mx-6 mt-4 border-t border-gray-200 dark:border-white/10">
                  <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                    <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-x-4 px-6 py-3 text-sm font-semibold leading-6 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-white/5 w-full text-left" id="user-menu-button-mobile" aria-expanded="false" aria-haspopup="true">
                      <span class="sr-only">Your profile</span>
                      <span class="flex flex-col truncate">
                        <span aria-hidden="true" class="truncate"><%= Current.user&.name %></span>
                        <span aria-hidden="true" class="text-xs text-gray-500 truncate font-normal"><%= current_user_role %></span>
                      </span>
                      <svg class="size-5 text-gray-400 ml-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612l-3.96 4.158a.75.75 0 1 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
                      </svg>
                    </button>

                    <div data-dropdown-target="menu" class="hidden absolute bottom-full left-0 z-10 w-64 mb-2 ml-4 origin-bottom-left rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5 focus:outline-none dark:bg-gray-800 dark:ring-white/10" role="menu" aria-orientation="vertical" aria-labelledby="user-menu-button-mobile" tabindex="-1">
                      <%= link_to "Guides", guides_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5", role: "menuitem", tabindex: "-1" %>
                      <%= link_to "Settings", settings_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5", role: "menuitem", tabindex: "-1" %>
                      <%= link_to "Support", support_requests_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5", role: "menuitem", tabindex: "-1" %>
                      <div class="border-t border-gray-100 dark:border-white/5 my-1"></div>
                      <%= button_to "Logout", session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5 cursor-pointer", role: "menuitem", tabindex: "-1" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </el-dialog-panel>
        </div>
      </dialog>

      <% if show_account_switcher? %>
      <dialog id="account-switcher" class="backdrop:bg-transparent bg-transparent border-0 p-0 overflow-visible">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-900/80 transition-opacity duration-300 ease-linear data-closed:opacity-0" command="close" commandfor="account-switcher"></el-dialog-backdrop>
        <div class="fixed inset-0 z-[70] flex items-center justify-center p-4 pointer-events-none">
          <el-dialog-panel class="relative w-full max-w-md transform overflow-hidden rounded-lg bg-white p-6 text-left shadow-xl transition-all dark:bg-gray-800 dark:ring-1 dark:ring-white/10 pointer-events-auto">
            <div class="absolute top-0 right-0 pt-4 pr-4">
              <button type="button" command="close" commandfor="account-switcher" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none dark:bg-gray-800 dark:text-gray-500 dark:hover:text-gray-400">
                <span class="sr-only">Close</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <div>
              <h3 class="text-base font-semibold leading-6 text-gray-900 dark:text-white" id="modal-title">Switch Account</h3>
              <div class="mt-4">
                <ul role="list" class="divide-y divide-gray-200 dark:divide-gray-700">
                  <% switchable_accounts.each do |entry| %>
                    <li class="py-4">
                      <div class="flex items-center justify-between">
                        <div class="flex flex-col">
                          <span class="text-sm font-medium text-gray-900 dark:text-white"><%= entry[:name] %></span>
                          <span class="text-xs text-gray-500 dark:text-gray-400"><%= entry[:role] %></span>
                        </div>
                        <% if Current.account&.id == entry[:id] %>
                          <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20 dark:bg-green-900/20 dark:text-green-400 dark:ring-green-500/20">Active</span>
                        <% else %>
                          <%= button_to "Switch", managed_account_path(account_id: entry[:id]), method: :patch, class: "rounded bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-gray-700 dark:text-white dark:ring-gray-600 dark:hover:bg-gray-600" %>
                        <% end %>
                      </div>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </el-dialog-panel>
        </div>
      </dialog>
      <% end %>
      <% end %>
    </el-dialog>

    <!-- Static sidebar for desktop -->
    <% unless content_for?(:no_sidebar) %>
      <div class="hidden lg:fixed lg:z-50 lg:flex lg:w-72 lg:flex-col dark:bg-gray-900 <%= show_admin_support_banner ? "lg:top-12 lg:bottom-0" : "lg:inset-y-0" %>">
      <!-- Sidebar component, swap this element with another sidebar if you like -->
      <div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-gray-200 bg-white px-6 dark:border-white/10 dark:bg-black/10">
        <% sidebar_staff_navigation = staff_navigation? %>
        <% sidebar_unread_notifications_count = sidebar_staff_navigation ? unread_notifications_count : 0 %>
        <div class="flex h-16 shrink-0 items-center justify-between">
          <div class="flex items-center">
            <%= image_tag "icon.svg", alt: "Harvest", class: "h-8 w-auto dark:hidden" %>
            <%= image_tag "icon.svg", alt: "Harvest", class: "h-8 w-auto not-dark:hidden" %>
          </div>
          <% if sidebar_staff_navigation %>
            <%= link_to notifications_path, id: "desktop-sidebar-notifications-link", class: nav_icon_button_classes(:notifications), aria: { label: "Notifications" } do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="<%= nav_icon_classes(:notifications) %>">
                <path d="M14.857 17.082a23.848 23.848 0 0 1 5.454 1.31A8.967 8.967 0 0 1 18 9.75v-.7V9A6 6 0 0 0 6 9v.05a8.967 8.967 0 0 1-2.312 9.343 23.848 23.848 0 0 1 5.454-1.31m5.715 0a24.255 24.255 0 0 0-5.714 0m5.714 0a3 3 0 1 1-5.714 0" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <% if sidebar_unread_notifications_count.positive? %>
                <span id="desktop-notifications-badge" class="absolute -right-1 -top-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-600 px-1 text-[0.625rem] font-bold text-white"><%= sidebar_unread_notifications_count > 99 ? "99+" : sidebar_unread_notifications_count %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <%= render "layouts/navigation", mobile: false %>

          <% if authenticated? %>
            <ul role="list" class="-mx-2 mt-auto space-y-1">
              <% if show_account_switcher? %>
                <li>
                  <button type="button" command="show-modal" commandfor="account-switcher" class="group flex w-full gap-x-3 rounded-md p-2 text-sm/6 font-semibold text-gray-700 hover:text-indigo-600 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-white/5">
                    <svg class="size-6 shrink-0 text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                    </svg>
                    Switch Account
                  </button>
                </li>
              <% end %>
            </ul>

            <%= render "layouts/sidebar_cart_link", sidebar: :desktop %>

            <div class="-mx-6 mt-4 border-t border-gray-200 dark:border-white/10">
              <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-x-4 px-6 py-3 text-sm font-semibold leading-6 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-white/5 w-full text-left" id="user-menu-button-desktop" aria-expanded="false" aria-haspopup="true">
                  <span class="sr-only">Your profile</span>
                  <span class="flex flex-col truncate">
                    <span aria-hidden="true" class="truncate"><%= Current.user&.name %></span>
                    <span aria-hidden="true" class="text-xs text-gray-500 truncate font-normal"><%= current_user_role %></span>
                  </span>
                  <svg class="size-5 text-gray-400 ml-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612l-3.96 4.158a.75.75 0 1 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
                  </svg>
                </button>

                <div data-dropdown-target="menu" class="hidden absolute bottom-full left-0 z-10 w-64 mb-2 ml-4 origin-bottom-left rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5 focus:outline-none dark:bg-gray-800 dark:ring-white/10" role="menu" aria-orientation="vertical" aria-labelledby="user-menu-button-desktop" tabindex="-1">
                  <%= link_to "Guides", guides_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5", role: "menuitem", tabindex: "-1" %>
                  <%= link_to "Settings", settings_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5", role: "menuitem", tabindex: "-1" %>
                  <%= link_to "Support", support_requests_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5", role: "menuitem", tabindex: "-1" %>
                  <div class="border-t border-gray-100 dark:border-white/5 my-1"></div>
                  <%= button_to "Logout", session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/5 cursor-pointer", role: "menuitem", tabindex: "-1" %>
                </div>
              </div>
            </div>
          <% end %>
      </div>
    </div>
    <% end %>

    <% unless content_for?(:no_sidebar) %>
    <div class="sticky top-0 z-40 flex items-center gap-x-6 bg-white px-4 py-4 shadow-xs sm:px-6 lg:hidden dark:bg-gray-900 dark:shadow-none dark:after:pointer-events-none dark:after:absolute dark:after:inset-0 dark:after:border-b dark:after:border-white/10 dark:after:bg-black/10">
      <button type="button" command="show-modal" commandfor="sidebar" class="-m-2.5 p-2.5 text-gray-700 hover:text-gray-900 lg:hidden dark:text-gray-400 dark:hover:text-white">
        <span class="sr-only">Open sidebar</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
          <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="flex-1 text-sm/6 font-semibold text-gray-900 dark:text-white"><%= content_for?(:title) ? yield(:title) : "Dashboard" %></div>
    </div>
    <% end %>

    <main class="py-10 <%= content_for?(:no_sidebar) ? '' : 'lg:pl-72' %>">
      <div class="px-4 sm:px-6 lg:px-8">

        <%= yield %>
      </div>
    </main>

  </body>
</html>
