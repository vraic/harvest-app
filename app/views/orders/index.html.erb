<% content_for :title, "Order history" %>

<div class="w-full">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Order history</h1>
      <p class="mt-2 text-sm text-gray-500">Check the status of recent orders.</p>
    </div>
  </div>

  <div class="mt-8 bg-white dark:bg-gray-800 p-4 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
    <%= form_with url: orders_path, method: :get, class: "flex gap-2", id: "order-search-form" do |f| %>
      <div class="grow">
        <%= f.label :query, "Search orders", class: "sr-only" %>
        <%= f.text_field :query, value: params[:query], placeholder: "Search by order #, customer, or total...", class: input_class %>
      </div>
      <%= f.submit "Search", class: secondary_button_class %>
      <%= link_to "Clear", orders_path, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-gray-700 dark:text-white dark:ring-gray-600" if params[:query].present? %>
    <% end %>
  </div>

  <div class="mt-8 <%= table_container_class %>">
    <table class="<%= table_class %>">
      <thead class="<%= thead_class %>">
        <tr>
          <th class="<%= th_class %>">Order #</th>
          <% if staff? %>
            <th class="<%= th_class %>">Customer</th>
          <% end %>
          <th class="<%= th_class %>">Shop</th>
          <th class="<%= th_class %>">Date</th>
          <th class="<%= th_class("text-right") %>">Total</th>
          <th class="<%= th_class %>">Status</th>
          <th class="<%= th_class("text-right") %>">
            <span class="sr-only">View</span>
          </th>
        </tr>
      </thead>
      <tbody class="<%= tbody_class %>">
        <% if @orders.any? %>
          <% @orders.each do |order| %>
            <tr class="<%= tr_class("hover:bg-gray-50 dark:hover:bg-gray-900/50") %>">
              <td class="<%= td_class("font-medium") %>">
                <%= link_to order.number, order, class: "text-indigo-600 hover:text-indigo-900 dark:text-indigo-400" %>
              </td>
              <% if staff? %>
                <td class="<%= td_class("text-gray-500 dark:text-gray-400") %>">
                  <%= order.customer&.name || "N/A" %>
                </td>
              <% end %>
              <td class="<%= td_class("text-gray-500 dark:text-gray-400") %>">
                <%= order.account.name %>
              </td>
              <td class="<%= td_class("text-gray-500 dark:text-gray-400") %>">
                <%= order.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="<%= td_class("text-right text-gray-500 dark:text-gray-400") %>">
                <%= order.total_amount.format %>
              </td>
              <td class="<%= td_class %>">
                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= 
                  case order.status
                  when 'ordered' then 'bg-yellow-50 text-yellow-800 ring-yellow-600/20'
                  when 'awaiting_collection' then 'bg-blue-50 text-blue-800 ring-blue-600/20'
                  when 'complete' then 'bg-green-50 text-green-800 ring-green-600/20'
                  else 'bg-gray-50 text-gray-600 ring-gray-500/10'
                  end %>">
                  <%= order.status.titleize %>
                </span>
              </td>
              <td class="<%= td_class("text-right") %>">
                <%= link_to "View", order, class: "text-indigo-600 hover:text-indigo-900 dark:text-indigo-400" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="<%= staff? ? 7 : 6 %>" class="<%= td_class("py-10 text-center text-gray-500 dark:text-gray-400") %>">No orders found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-8 flex justify-center">
    <%== pagy_tailwind_nav(@pagy) %>
  </div>
</div>
