<% content_for :title, "Vraic OS" %>
<% content_for :no_sidebar, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<% end %>

<div class="-mx-4 -my-10 min-h-screen bg-stone-950 text-stone-100 sm:-mx-6 lg:-mx-8">
  <div class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(163,230,53,0.2),transparent_42%),radial-gradient(circle_at_85%_20%,rgba(96,165,250,0.12),transparent_28%)]"></div>

    <header class="relative border-b border-white/10">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-5 lg:px-8">
        <a href="#home" class="text-sm font-semibold uppercase tracking-[0.22em] text-lime-300">Vraic OS</a>
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium text-stone-200/90" aria-label="Homepage">
          <a href="#features" class="transition hover:text-white">Features</a>
          <a href="#platform" class="transition hover:text-white">Platform</a>
          <a href="#overview" class="transition hover:text-white">Overview</a>
          <a href="#faq" class="transition hover:text-white">FAQ</a>
        </nav>
        <%= link_to "Login", new_session_path, class: "inline-flex items-center rounded-full border border-lime-200/70 bg-lime-100 px-4 py-2 text-sm font-semibold text-stone-900 shadow-sm transition hover:bg-white" %>
      </div>
    </header>

    <section id="home" class="relative mx-auto max-w-7xl px-6 pb-20 pt-16 sm:pt-24 lg:px-8 lg:pb-28">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-lime-300">Built on the island, for the island</p>
          <h1 class="mt-5 text-5xl leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl" style="font-family: 'Instrument Serif', serif;">
            Operations software for the island's food network.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-300">
            Vraic helps farmers, growers, shops, wholesalers, and procurers on the island manage tasks, stock, procurement, and customer orders in one place.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <%= link_to "Get started", new_session_path, class: "inline-flex items-center rounded-full bg-lime-300 px-6 py-3 text-sm font-semibold text-stone-950 shadow-lg shadow-lime-300/20 transition hover:bg-lime-200" %>
            <a href="#features" class="inline-flex items-center rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-stone-100 transition hover:border-white/40 hover:bg-white/5">Explore features</a>
          </div>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl shadow-black/30 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-lime-300">What it helps with</p>
          <ul class="mt-5 space-y-4 text-sm text-stone-200">
            <li class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3">Track day-to-day work across island farm, grower, and shop teams.</li>
            <li class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3">Handle customer sales and trade procurement in the same account.</li>
            <li class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3">Keep access, notifications, and account context clear while keeping data on-island.</li>
          </ul>
        </div>
      </div>

      <dl id="overview" class="mt-14 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center">
          <dt class="text-xs uppercase tracking-[0.14em] text-stone-300">Designed for daily use</dt>
          <dd class="mt-2 text-2xl font-semibold text-white">Simple workflows</dd>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center">
          <dt class="text-xs uppercase tracking-[0.14em] text-stone-300">Commerce support</dt>
          <dd class="mt-2 text-2xl font-semibold text-white">B2C + B2B</dd>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center">
          <dt class="text-xs uppercase tracking-[0.14em] text-stone-300">Access model</dt>
          <dd class="mt-2 text-2xl font-semibold text-white">Role-based</dd>
        </div>
      </dl>
    </section>
  </div>

  <section id="features" class="bg-stone-50 py-20 text-stone-900">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-700">Core capabilities</p>
        <h2 class="mt-4 text-4xl tracking-tight text-stone-950" style="font-family: 'Instrument Serif', serif;">Core workflows for island agri-business teams.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold">Task command center</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">Assign daily work, track progress, and keep farm, grower, and shop teams coordinated.</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold">Buyer & supplier flows</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">Run B2C ordering plus B2B procurement for chefs, wholesalers, restaurants, and other trade buyers.</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold">Inventory intelligence</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">Monitor produce, packaged stock, supplier coverage, and replenishment from one dashboard.</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold">Staff onboarding</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">Invite-based access with secure auth paths and clear first-login experiences.</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold">Account controls</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">Granular account context, support workflows, and business-level feature flags.</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold">Live notifications</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">In-app notification signals for orders and assignments scoped by account.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="platform" class="bg-stone-100 py-20 text-stone-900">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-700">Platform fit</p>
        <h2 class="mt-4 text-4xl tracking-tight text-stone-950" style="font-family: 'Instrument Serif', serif;">Built for practical day-to-day operations.</h2>
        <p class="mt-6 text-base leading-7 text-stone-600">The aim is simple: help agri-business teams on the island run operations and commerce clearly, without unnecessary complexity.</p>
      </div>
      <dl class="grid grid-cols-2 gap-4">
        <div class="rounded-2xl border border-stone-300 bg-white p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Role-aware UX</dt>
          <dd class="mt-2 text-sm font-medium text-stone-900">Admins, operators, suppliers, procurers, and customers each get focused navigation.</dd>
        </div>
        <div class="rounded-2xl border border-stone-300 bg-white p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Secure by default</dt>
          <dd class="mt-2 text-sm font-medium text-stone-900">Customer data stays private, access is permission-based, and every order is traceable.</dd>
        </div>
        <div class="rounded-2xl border border-stone-300 bg-white p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Team productivity</dt>
          <dd class="mt-2 text-sm font-medium text-stone-900">Tasks, orders, and inventory run from a single daily workflow.</dd>
        </div>
        <div class="rounded-2xl border border-stone-300 bg-white p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Flexible commerce</dt>
          <dd class="mt-2 text-sm font-medium text-stone-900">Support both direct customers and trade buyer relationships across the island's food network.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="faq" class="bg-stone-950 py-20 text-stone-100">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-300">FAQ</p>
        <h2 class="mt-4 text-4xl tracking-tight text-white" style="font-family: 'Instrument Serif', serif;">Common questions.</h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <h3 class="text-base font-semibold text-white">Can I use Vraic for one business?</h3>
          <p class="mt-3 text-sm leading-6 text-stone-300">Yes. Vraic works for a single farm, grower, or shop on the island and scales smoothly to multi-location operations.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <h3 class="text-base font-semibold text-white">Does it support wholesale and procurement teams?</h3>
          <p class="mt-3 text-sm leading-6 text-stone-300">Yes. Supplier/procurer access and B2B ordering are built in with account-level authorization.</p>
        </div>
      </div>
      <div class="mt-14 text-center">
        <%= link_to "Login", new_session_path, class: "inline-flex items-center rounded-full bg-lime-300 px-6 py-3 text-sm font-semibold text-stone-950 shadow-lg shadow-lime-300/20 transition hover:bg-lime-200" %>
      </div>
    </div>
  </section>
</div>