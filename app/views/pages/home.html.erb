<% content_for :title, "Harvest" %>
<% content_for :no_sidebar, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<% end %>

<div class="-mx-4 -my-10 min-h-screen bg-[#fbf6ec] text-stone-900 sm:-mx-6 lg:-mx-8">
  <header id="home" class="border-b border-stone-200">
    <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-6 lg:px-0">
      <a href="#home" class="text-lg font-semibold text-stone-900">Harvest</a>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-base text-stone-600" aria-label="Homepage">
        <%= link_to "Login", new_session_path, class: "text-stone-900 underline underline-offset-2 hover:text-amber-800" %>
      </nav>
    </div>
  </header>

  <section class="mx-auto max-w-3xl px-6 pb-20 pt-20 lg:px-0">
    <p class="text-lg font-semibold text-amber-800">What this is</p>
    <p class="mt-4 text-2xl leading-9 text-stone-700">
      Harvest is open-source software for the island's farmers, growers, and everyone who eats. It's built in the open by islanders as a community project.
    </p>

    <h1 class="mt-12 text-4xl leading-[1.1] tracking-tight text-stone-900 sm:text-5xl" style="font-family: 'Instrument Serif', serif;">
      Harvest exists to inspire new ways of thinking and being, so that everyone can live life to the fullest.
    </h1>
    <p class="mt-8 text-2xl leading-9 text-stone-700">
      That's why this project. Everything else is in service of it.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-6 text-lg">
      <%= link_to "Get started", new_session_path, class: "font-semibold text-stone-900 underline underline-offset-4 hover:text-amber-800" %>
      <a href="https://github.com/vraic/harvest-je" target="_blank" rel="noopener noreferrer" class="font-semibold text-stone-900 underline underline-offset-4 hover:text-amber-800">View the source</a>
    </div>
    <p class="mt-6 text-base leading-7 text-stone-500">
      Harvest has a fully managed, hosted offering at <a href="https://harvest.je" target="_blank" rel="noopener noreferrer" class="text-stone-700 underline underline-offset-2 hover:text-amber-800">harvest.je</a>.
    </p>
  </section>
</div>
