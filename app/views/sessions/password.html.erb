<% footer = capture do %>
  <%= link_to "Use a different email address", new_session_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>
<% end %>

<%= render layout: "shared/auth_card", locals: { title: "Sign in to Harvest", subtitle: @user.email_address, footer: footer } do %>
  <%= form_with url: session_path, class: "space-y-6", data: { turbo: false } do |form| %>
    <%= form.hidden_field :email_address, value: @email_address %>

    <div>
      <%= form.label :password, "Password", class: label_class %>
      <div class="mt-2">
        <%= form.password_field :password, autofocus: true, autocomplete: "current-password", maxlength: 72, class: input_class %>
      </div>
    </div>

    <div class="flex items-center justify-end">
      <div class="text-sm/6">
        <%= link_to "Forgot password?", new_password_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>
      </div>
    </div>

    <div>
      <%= form.submit "Sign in", class: primary_button_class("flex w-full justify-center") %>
    </div>
  <% end %>
<% end %>
