<% content_for :title, @account ? "Sign up for #{@account.name}" : "Sign up" %>

<% footer = capture do %>
  Already have an account? <%= link_to "Sign in", new_session_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>
<% end %>

<%= render layout: "shared/auth_card", locals: { title: @account ? "Sign up for #{@account.name}" : "Create your account", footer: footer } do %>
  <%= render "form", user: @user %>

  <p class="mt-6 text-center text-xs/5 text-gray-500 dark:text-gray-400">
    By signing up, you agree to our <%= link_to "Terms of Service", terms_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>
    and <%= link_to "Privacy Policy", privacy_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>.
  </p>
<% end %>
