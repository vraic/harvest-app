<% content_for :title, "Showing supplier" %>

<div class="md:w-2/3 w-full">
  
  <h1 class="font-bold text-4xl">Showing supplier</h1>

  <%= render @supplier %>

  <div class="<%= table_container_class("p-6 mt-6") %>">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Retention hold</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 mt-1 mb-4">Mark this record to prevent automated retention actions until the hold expires or is removed.</p>

    <%= form_with model: @supplier, url: update_retention_hold_supplier_path(@supplier), method: :patch, class: "space-y-4" do |form| %>
      <div>
        <label class="inline-flex items-center gap-2 text-sm text-gray-900 dark:text-white">
          <%= form.check_box :retention_hold, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          Keep this supplier record
        </label>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= form.label :retention_hold_until, "Keep until (optional)", class: label_class("mb-1") %>
          <%= form.date_field :retention_hold_until, class: input_class(@supplier.errors[:retention_hold_until].any?) %>
        </div>

        <div>
          <%= form.label :retention_hold_reason, "Reason (optional)", class: label_class("mb-1") %>
          <%= form.text_field :retention_hold_reason, class: input_class(@supplier.errors[:retention_hold_reason].any?), placeholder: "e.g. Minor, retain 7 years after age 18" %>
        </div>
      </div>

      <%= form.submit "Save retention hold", class: primary_button_class %>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2 mt-4">
    <%= link_to "Edit this supplier", edit_supplier_path(@supplier), class: secondary_button_class("w-full sm:w-auto text-center") %>
    <%= link_to "Back to suppliers", suppliers_path, class: secondary_button_class("w-full sm:w-auto text-center") %>
    <%= button_to "Destroy this supplier", @supplier, method: :delete, form_class: "w-full sm:w-auto", class: danger_button_class("w-full"), data: { turbo_confirm: "Are you sure?" } %>
    <% if @supplier.supplier_account_id.present? %>
      <%= link_to "View Inventory", inventory_supplier_path(@supplier), class: primary_button_class("w-full sm:w-auto text-center") %>
    <% end %>
  </div>
</div>
