<% subtitle = @user.otp_enabled? ? "Please enter the code from your authenticator app." : "We've sent a verification code to your email address." %>

<% footer = capture do %>
  <%= link_to "Back to sign in", new_session_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>
<% end %>

<%= render layout: "shared/auth_card", locals: { title: "Two-Factor Verification", subtitle: subtitle, footer: footer } do %>
  <%= form_with url: two_factor_verification_path, method: :post, class: "space-y-6", data: { turbo: false } do |f| %>
    <div>
      <%= f.label :otp_code, "Verification Code", class: label_class %>
      <div class="mt-2">
        <%= f.text_field :otp_code, autofocus: true, autocomplete: "one-time-code", inputmode: @user.otp_enabled? ? "numeric" : "text", class: input_class %>
      </div>
    </div>

    <div>
      <%= f.submit "Verify", class: primary_button_class("flex w-full justify-center") %>
    </div>
  <% end %>
<% end %>
